[general]
	#Multiplier for combat XP gain (0.0 to 10.0)
	# Default: 1.0
	# Range: 0.0 ~ 10.0
	combatXpMultiplier = 1.0
	#Multiplier for non-combat XP gain (0.0 to 10.0)
	# Default: 1.0
	# Range: 0.0 ~ 10.0
	nonCombatXpMultiplier = 1.0
	#Maximum stat level (1 to 100)
	# Default: 100
	# Range: 1 ~ 100
	maxStatLevel = 100
	#Base perk points granted per stat level
	# Default: 1
	# Range: 0 ~ 10
	basePerkPointsPerLevel = 1
	#Multiplicateur de dégâts de MÊLÉE de base du joueur (niveau 0 de stat).
	#1.0 = dégâts d'arme bruts. Monte ce chiffre si TOUTES les armes tapent trop faible.
	# Default: 1.5
	# Range: 0.5 ~ 10.0
	weaponDamageBase = 1.5
	#Amplitude du bonus de dégâts par la stat de combat, au niveau MAX.
	#À 3.0, une stat de combat maxée ajoute ×3 par-dessus la base (donc ~×4.5 total).
	# Default: 3.0
	# Range: 0.0 ~ 20.0
	weaponDamageScale = 3.0

[trial_dungeon]
	#Multiplier de base pour l'XP gagné dans le Trial Dungeon (ajouté à floor*perFloor).
	# Default: 1.0
	# Range: 0.0 ~ 10.0
	xpBaseMultiplier = 1.0
	#Multiplier XP additionnel par étage — étage 20 donne XP*(base + 20*perFloor).
	# Default: 0.05
	# Range: 0.0 ~ 1.0
	xpPerFloor = 0.05
	#Nombre de niveaux de stat gagnés directement à la mort d'un boss d'étage.
	# Default: 2
	# Range: 0 ~ 10
	bossStatGain = 2
	#Intégration L2 Hostility : facteur de niveau par étage.
	#0.0 = utiliser la COURBE D'ÉQUILIBRAGE INTÉGRÉE (recommandé) : douce au début,
	#  qui accélère en profondeur (étage 10≈niv 7, 50≈38, 100≈78, plafonnée par le cap).
	#> 0.0 = mode manuel : niveau = floor × ce facteur (écrase la courbe intégrée).
	# Default: 0.0
	# Range: 0.0 ~ 0.5
	l2HostilityPerFloor = 0.5
	#Intégration L2 Hostility : plafond du niveau appliqué par étage (courbe et mode manuel).
	# Default: 100
	# Range: 0 ~ 500
	l2HostilityCap = 200
