[general]
	#Multiplier for combat XP gain (0.0 to 10.0)
	# Default: 1.0
	# Range: 0.0 ~ 10.0
	combatXpMultiplier = 1.0
	#Multiplier for non-combat XP gain (0.0 to 10.0)
	# Default: 1.0
	# Range: 0.0 ~ 10.0
	nonCombatXpMultiplier = 1.0
	#Maximum stat level (1 to 100)
	# Default: 100
	# Range: 1 ~ 100
	maxStatLevel = 100
	#Base perk points granted per stat level
	# Default: 1
	# Range: 0 ~ 10
	basePerkPointsPerLevel = 1
