{
    ranks: [
        { name: "Novice" power: 1 condition: "statmod:global_level >= 10" }
        { name: "Apprentice" power: 2 condition: "statmod:global_level >= 25" }
        { name: "Adept" power: 3 condition: "statmod:global_level >= 50" }
        { name: "Expert" power: 4 condition: "statmod:global_level >= 75" }
        { name: "Master" power: 5 condition: "statmod:global_level >= 90" }
        { name: "Legend" power: 6 condition: "statmod:global_level >= 100" }
    ]
}
